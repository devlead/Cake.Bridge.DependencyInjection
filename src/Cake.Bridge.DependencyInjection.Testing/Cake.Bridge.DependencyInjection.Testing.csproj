<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Cake.Core" Version="7.0.0" />
    <PackageReference Include="Cake.Testing" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Cake.Bridge.DependencyInjection.Testing.props" Pack="true" PackagePath="build\net10.0\Cake.Bridge.DependencyInjection.Testing.props" />
    <None Include="Cake.Bridge.DependencyInjection.Testing.props" Pack="true" PackagePath="build\net11.0\Cake.Bridge.DependencyInjection.Testing.props" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cake.Bridge.DependencyInjection\Cake.Bridge.DependencyInjection.csproj" />
  </ItemGroup>

  <Import Project="Cake.Bridge.DependencyInjection.Testing.props" />
</Project>
